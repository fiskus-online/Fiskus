# config.js nesie verziu a odkazy na inštalátory z posledného vydania — prehliadač ho má vždy overiť
/config.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# kurzy a sadzba ECB pre Fiškus v prehliadači (app.fiskus.online), obnovené denne
/kurzy/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
